# Copie este arquivo para .env e preencha com os dados do Supabase do projeto novo.
# A anon key é pública por design — o acesso real é protegido por RLS no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave pública VAPID das notificações push. A privada fica só no banco
# (tabela push_config), acessível apenas pela Edge Function.
VITE_VAPID_PUBLIC_KEY=
